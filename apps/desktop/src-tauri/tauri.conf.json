{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "heka-ghost-desktop",
  "version": "2026.10.0",
  "identifier": "dev.heka.ghost",
  "build": {
    "beforeDevCommand": "pnpm --filter @ghost/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -w sidecars && pnpm --filter @ghost/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Ghost voice assistant: the app that runs Ghost",
    "longDescription": "Ghost, a voice-first assistant for one Linux workstation. The app carries the daemon (ghostd) and runs it while you are logged in; closing the window keeps it in the tray, and Quit stops everything.",
    "externalBin": ["binaries/ghostd", "binaries/ghost-mock-github", "binaries/ghost-scripts"],
    "resources": { "resources/onnxruntime/": "onnxruntime/" },
    "linux": {
      "deb": {
        "depends": ["libespeak-ng1"],
        "section": "utils",
        "desktopTemplate": "./ghost.desktop"
      }
    }
  }
}
