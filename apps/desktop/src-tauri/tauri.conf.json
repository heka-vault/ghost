{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost",
  "version": "0.1.0",
  "identifier": "dev.heka.ghost",
  "build": {
    "beforeDevCommand": "pnpm --filter @ghost/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @ghost/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Ghost voice assistant: status, chat, policy and audit",
    "linux": {
      "deb": {
        "depends": ["heka-ghostd"],
        "section": "utils",
        "desktopTemplate": "./ghost.desktop"
      }
    }
  }
}
