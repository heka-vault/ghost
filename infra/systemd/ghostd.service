# Ghost desktop daemon (ADR 0009). Install:
#   mkdir -p ~/.config/systemd/user && cp infra/systemd/ghostd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now ghostd
# The environment is settings.env, which holds no secret. Passwords are in Ghost's own vault,
# which the daemon opens itself; its key is in your keyring (ADR 0036). Nothing secret is
# baked into this file or rendered beside it.
[Unit]
Description=Ghost voice assistant daemon
After=pipewire.service pipewire-pulse.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/active/ghost
EnvironmentFile=-%h/.config/ghost/settings.env
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=%h/.local/bin/uv run --frozen --package ghostd ghostd run
# Undo any music ducking left behind by a crash.
ExecStopPost=%h/.local/bin/uv run --frozen --package ghostd ghostd restore-volumes
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
Nice=-5

[Install]
WantedBy=default.target
