# Build environment for heka-ghost: the three Debian packages are produced inside this
# image so the host needs neither Tauri's GTK/WebKit dev libraries nor root.
#   docker build -t heka-ghost-build -f packaging/Dockerfile.build .
#   docker run --rm -v "$PWD":/src -w /src heka-ghost-build packaging/build-debs.sh
FROM ubuntu:26.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git build-essential pkg-config file patchelf fakeroot dpkg-dev \
      libssl-dev libgtk-3-dev libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev \
      libxdo-dev libportaudio2 xz-utils \
    && rm -rf /var/lib/apt/lists/*
# Rust (for the Tauri shell)
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
# Node + pnpm (for the frontend)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y --no-install-recommends nodejs \
    && corepack enable && corepack prepare pnpm@11.10.0 --activate && rm -rf /var/lib/apt/lists/*
# uv (for the Python runtime bundle)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
ENV CARGO_HOME=/cache/cargo RUSTUP_HOME=/root/.rustup UV_CACHE_DIR=/cache/uv PNPM_HOME=/cache/pnpm
RUN mkdir -p /cache/cargo /cache/uv /cache/pnpm && cp -r /root/.cargo/. /cache/cargo/
WORKDIR /src
