# Ghost voice assistant daemon (heka-ghostd). Per-user service: audio is a session
# resource. Enable with `systemctl --user enable --now ghostd`; the desktop app does
# this on first run.
[Unit]
Description=Ghost voice assistant daemon
After=pipewire.service pipewire-pulse.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Renders secrets from the operator's vault when ~/.config/heka-vault/ghost.env exists;
# otherwise a no-op and the daemon reads ~/.config/ghost/env written by the app.
ExecStartPre=-/usr/share/heka-ghost/ghost-render-env.sh
EnvironmentFile=-%h/.config/ghost/env
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=GHOST_INFRA_DIR=/usr/share/heka-ghost
ExecStart=/usr/bin/ghostd run
# Undo any music ducking left behind by a crash.
ExecStopPost=/usr/bin/ghostd restore-volumes
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
Nice=-5

[Install]
WantedBy=default.target
