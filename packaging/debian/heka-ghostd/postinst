#!/bin/sh
set -e
# Nothing network-bound here: models download on the user's first run. The unit is a
# user unit, so it is enabled per user by the desktop app or by hand:
#   systemctl --user enable --now ghostd
if [ "$1" = "configure" ]; then
  # Byte-compile is skipped on purpose (size); the runtime compiles lazily into its own tree.
  chmod 755 /opt/ghost/venv/bin/* 2>/dev/null || true
  echo "heka-ghostd installed. Per user: systemctl --user enable --now ghostd  (or open Ghost)."
fi
exit 0
