{
  "name": "@ghost/client-ts",
  "version": "2026.10.0",
  "private": true,
  "description": "Typed client for the Ghost control API, generated from packages/api/openapi.json",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../api/openapi.json -o src/schema.d.ts --alphabetize --root-types",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
