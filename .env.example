# Rendered automatically by infra/systemd/ghost-render-env.sh into ~/.config/ghost/env.
# For a manual run: `set -a; . .env; set +a; uv run ghostd run`
ANTHROPIC_BASE_URL=http://localhost:8317     # any Anthropic-compatible endpoint
ANTHROPIC_AUTH_TOKEN=
GITHUB_TOKEN=                                 # fine-grained PAT: Metadata read, Issues read/write
GHOST_REPOS=owner/repo,owner/other            # allowlist, also enforced by the PAT's repo selection
GHOST_GITHUB_MOCK=1                           # until the PAT exists: in-memory issues in ghost-mock/app, ghost-mock/infra
# Optional
# GHOST_LLM_MODEL=claude-sonnet-5-5
# GHOST_LLM_THINKING=between_tools
# GHOST_TTS_VOICE=af_heart
# GHOST_DUCK_APPS=["spotify"]
# GHOST_WAKE_MODE=file                        # file (ghostd wake / SIGUSR1) until the wake model exists
# GHOST_INPUT_DEVICE=ghost.mic                # sounddevice name substring or index
# HF_TOKEN=                                   # avoids Hugging Face rate limits on first model download
