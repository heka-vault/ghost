# Non-secret settings, as ~/.config/ghost/settings.env holds them. A ./.env made from this file
# is what `make` loads instead (for a manual run: `set -a; . .env; set +a; target/debug/ghostd run`).
# Never put a password here: passwords are in Ghost's own vault (ADR 0036). Save one with
# Settings › Passwords, or `ghostd passwords set ANTHROPIC_AUTH_TOKEN` (and
# OPENROUTER_API_KEY, TYPESAFE_API_KEY, ELEVENLABS_API_KEY, HF_TOKEN, GITHUB_TOKEN, ...).
# The model connection (ADR 0037); Settings › Model in the desktop app writes these. Its key
# is a password: ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY (signing in sets it),
# ANTHROPIC_AUTH_TOKEN for CLIProxy, or the one GHOST_LLM_PASSWORD names.
# GHOST_LLM_PROVIDER=anthropic                # anthropic | openrouter | cliproxy | openai | ollama | lmstudio | custom
# GHOST_LLM_BASE_URL=                         # another address than the provider's (cliproxy, custom)
# GHOST_LLM_PROTOCOL=anthropic                # custom only: anthropic | openai
# GHOST_LLM_PASSWORD=                         # the password that holds the key, when not the provider's own
# Older settings, used while GHOST_LLM_PROVIDER is unset:
ANTHROPIC_BASE_URL=http://localhost:8317     # any Anthropic-compatible endpoint (GHOST_LLM_ENDPOINT=proxy)
# GHOST_LLM_ENDPOINT=proxy                    # proxy: the two lines above (default) | openrouter: OpenRouter's
#                                             # Anthropic API with the OPENROUTER_API_KEY password; GHOST_LLM_MODEL maps to its id
# Optional
# GHOST_LLM_MODEL=claude-sonnet-5-5
# GHOST_LLM_THINKING=between_tools
# GHOST_TTS_VOICE=af_heart
# GHOST_TTS_CLAUSES=true                      # speak from the first clause; false = whole sentences
# GHOST_TTS_ENGINE=kokoro                     # kokoro (local, default) | elevenlabs: Flash v2.5 over its
#                                             # websocket; Kokoro speaks if the key is missing or the socket fails
#                                             # (its password is ELEVENLABS_API_KEY; only the reply text Ghost speaks is sent)
# GHOST_ELEVENLABS_VOICE=                     # ElevenLabs voice id, for every line
# GHOST_ELEVENLABS_VOICES=accounting=<voice id>  # optional, by line slug; other lines use the one above
# GHOST_ELEVENLABS_MODEL=eleven_flash_v2_5
# GHOST_DUCK_APPS=["spotify"]
# GHOST_WAKE_MODE=transcript                  # transcript (default) | onnx (the trained "hey ghost" detector only, ADR 0025) | file (ghostd wake / SIGUSR1 only)
# GHOST_WAKE_MODEL_PATH=                      # onnx: the model; default ~/.cache/ghost/wake/hey_ghost.onnx
# GHOST_WAKE_THRESHOLD=                       # onnx: the detector's score for "hey ghost"; unset = 0.3 with the check, 0.7 without
# GHOST_WAKE_VERIFY=true                      # onnx: Parakeet confirms each hit; false = the detector alone, chime at once
# GHOST_WAKE_ADDRESS_MODEL_PATH=              # onnx: "Ghost, <request>"; default every ~/.cache/ghost/wake/ghost_*.onnx
# GHOST_WAKE_ADDRESS_VERIFY=                  # onnx: Parakeet checks "Ghost, …" hits; unset = as GHOST_WAKE_VERIFY
# GHOST_WAKE_ADDRESS_THRESHOLD=               # their score that counts as a hit; unset = 0.3 with the check, 0.7 without
# GHOST_WAKE_PHRASES=hey ghost,ghost you there # comma-separated; default list in ghost_infer::wake
# GHOST_WAKE_FUZZY=0.9                        # accept spellings like "he ghost"; 0.8 also takes "hey guys"; 0 = exact only
# GHOST_WAKE_VAD_STOP_SECS=0.5                # passive end of speech; shorter splits "hey ghost, ..." at the comma
# GHOST_INPUT_DEVICE=ghost.mic                # echo-cancelled source from infra/pipewire/install.sh
# GHOST_BARGE_IN_MIN_WORDS=2                  # words needed to cut Ghost off mid-sentence, counted over 2 s; 0 = never
# GHOST_BARGE_IN_INTERIM_SECS=0.3             # re-read your speech this often while Ghost talks; 0 = wait for your pause
# GHOST_VAD_CONFIDENCE=0.7                    # raise with GHOST_VAD_MIN_VOLUME (0.6) in a noisy room
# GHOST_VAD_OVER_GHOST_CONFIDENCE=0.5         # the VAD while Ghost speaks: the canceller passes you in 150-350 ms pieces
# GHOST_VAD_OVER_GHOST_START_SECS=0.1         #   so it starts quicker; what it starts on is judged by the words, not the VAD
# GHOST_VAD_OVER_GHOST_MIN_VOLUME=0.3         #   the cancelled stream sits far below the room's floor
# GHOST_VAD_OVER_GHOST_STOP_SECS=0.6          #   and a segment waits longer to close, so "okay, okay .. stop" is one segment
# GHOST_TURN_GRACE_SECS=1.2                   # after Smart Turn hears an end, wait this long in case you go on
# GHOST_TURN_STOP_SECS=1.6                    # Smart Turn hears no end but the words end a sentence: close after this silence
# GHOST_TURN_UNFINISHED_SECS=3                # the words don't end a sentence ("can you", "tell me about"): this silence
# GHOST_TURN_SENTENCE_MIN_PROB=0.1            # a full stop shortens the wait only when Smart Turn's "done" is at least this
# GHOST_THINKING_SOUND=0                      # the sound while the model works; off: it leaks through the canceller and reads as a voice
# GHOST_TURN_SPECULATE=true                   # start answering during the 1.2 s turn grace; false = wait it out
# GHOST_ACK=true                             # "Sure." or "On it." as Ghost goes to an app for an answer; false = silent until it has one
# GHOST_API_SOCKET=                           # control API socket; default $XDG_RUNTIME_DIR/ghost/api.sock
# GHOST_PHONE_LISTEN=192.168.1.20:8765        # phone listener on this LAN address (ADR 0016); empty = off
# GHOST_HOOKS_LISTEN=0.0.0.0:8766            # webhook listener, POST /hooks/<name> only (ADR 0027); empty = off
# GHOST_POLICY_PATH=~/.config/ghost/policy.toml  # autonomy per operation (ADR 0011); template in infra/policy.example.toml
# GHOST_JEV=auto                              # auto (Jev when the TYPESAFE_API_KEY or OPENROUTER_API_KEY password is set, else regex) | on | off
# GHOST_DEBUG_AUDIO=1                         # log transcripts, VAD and turn decisions; off by default, local only
# GHOST_LOG_LEVEL=DEBUG                       # everything, every stage of the pipeline (very noisy)

# Apps and skills (ADR 0034, 0023): extra passwords your own config names as ${NAME}, listed on
# Settings › Passwords (an app connected in the desktop has its own already); project roots
# whose .agents/skills are read in place.
# GHOST_APP_SECRETS=MCP_PROXY_KEY,GITHUB_TOKEN
# GHOST_SIGNIN_PORT=47823                     # where a sign-in's browser comes back, on 127.0.0.1 only
# GHOST_SKILL_ROOTS=~/projects/one,~/projects/two
