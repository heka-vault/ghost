# Rendered automatically by infra/systemd/ghost-render-env.sh into ~/.config/ghost/env.
# For a manual run: `set -a; . .env; set +a; uv run ghostd run`
ANTHROPIC_BASE_URL=http://localhost:8317     # any Anthropic-compatible endpoint (GHOST_LLM_ENDPOINT=proxy)
ANTHROPIC_AUTH_TOKEN=
# GHOST_LLM_ENDPOINT=proxy                    # proxy: the two lines above (default) | openrouter: OpenRouter's
#                                             # Anthropic API with OPENROUTER_API_KEY; GHOST_LLM_MODEL maps to its id
GITHUB_TOKEN=                                 # a PAT for the GitHub MCP server declared in policy.toml (docs/mcp.md)
# Optional
# GHOST_LLM_MODEL=claude-sonnet-5-5
# GHOST_LLM_THINKING=between_tools
# GHOST_TTS_VOICE=af_heart
# GHOST_TTS_CLAUSES=true                      # speak from the first clause; false = whole sentences
# GHOST_TTS_ENGINE=kokoro                     # kokoro (local, default) | elevenlabs: Flash v2.5 over its
#                                             # websocket; Kokoro speaks if the key is missing or the socket fails
# ELEVENLABS_API_KEY=                         # only the reply text Ghost speaks is sent, never the microphone
# GHOST_ELEVENLABS_VOICE=                     # ElevenLabs voice id, for every line
# GHOST_ELEVENLABS_VOICES=accounting=<voice id>  # optional, by line slug; other lines use the one above
# GHOST_ELEVENLABS_MODEL=eleven_flash_v2_5
# GHOST_DUCK_APPS=["spotify"]
# GHOST_WAKE_MODE=transcript                  # transcript (default) | onnx (the trained "hey ghost" detector only, ADR 0025) | file (ghostd wake / SIGUSR1 only)
# GHOST_WAKE_MODEL_PATH=                      # onnx: the model; default ~/.cache/ghost/wake/hey_ghost.onnx
# GHOST_WAKE_THRESHOLD=                       # onnx: the detector's score for "hey ghost"; unset = 0.3 with the check, 0.7 without
# GHOST_WAKE_VERIFY=true                      # onnx: Parakeet confirms each hit; false = the detector alone, chime at once
# GHOST_WAKE_ADDRESS_MODEL_PATH=              # onnx: "Ghost, <request>"; default every ~/.cache/ghost/wake/ghost_*.onnx
# GHOST_WAKE_ADDRESS_VERIFY=                  # onnx: Parakeet checks "Ghost, …" hits; unset = as GHOST_WAKE_VERIFY
# GHOST_WAKE_ADDRESS_THRESHOLD=               # their score that counts as a hit; unset = 0.3 with the check, 0.7 without
# GHOST_WAKE_PHRASES=hey ghost,ghost you there # comma-separated; default list in ghost_voice.wake
# GHOST_WAKE_FUZZY=0.9                        # accept spellings like "he ghost"; 0.8 also takes "hey guys"; 0 = exact only
# GHOST_WAKE_VAD_STOP_SECS=0.5                # passive end of speech; shorter splits "hey ghost, ..." at the comma
# GHOST_INPUT_DEVICE=ghost.mic                # echo-cancelled source from infra/pipewire/install.sh
# GHOST_BARGE_IN_MIN_WORDS=2                  # words needed to cut Ghost off mid-sentence; 0 = never
# GHOST_BARGE_IN_INTERIM_SECS=0.3             # re-read your speech this often while Ghost talks; 0 = wait for your pause
# GHOST_VAD_CONFIDENCE=0.7                    # raise with GHOST_VAD_MIN_VOLUME (0.6) in a noisy room
# GHOST_TURN_SPECULATE=true                   # start answering during the 0.8 s turn grace; false = wait it out
# GHOST_API_SOCKET=                           # control API socket; default $XDG_RUNTIME_DIR/ghost/api.sock
# GHOST_PHONE_LISTEN=192.168.1.20:8765        # phone listener on this LAN address (ADR 0016); empty = off
# GHOST_HOOKS_LISTEN=0.0.0.0:8766            # webhook listener, POST /hooks/<department>/<name> only (ADR 0027); empty = off
# GHOST_POLICY_PATH=~/.config/ghost/policy.toml  # autonomy per operation (ADR 0011); template in infra/policy.example.toml
# GHOST_JEV=auto                              # auto (Jev when a key is set, else regex) | on | off
# TYPESAFE_API_KEY=                           # Jev direct; or OPENROUTER_API_KEY= to reach Jev through OpenRouter
# OPENROUTER_API_KEY=                         # also the model's key with GHOST_LLM_ENDPOINT=openrouter
# GHOST_DEBUG_AUDIO=1                         # log transcripts, VAD and turn decisions; off by default, local only
# GHOST_LOG_LEVEL=DEBUG                       # everything incl. Pipecat internals (very noisy)
# HF_TOKEN=                                   # avoids Hugging Face rate limits on first model download

# MCP servers and skills (ADR 0022, 0023): secrets a server's $NAME refers to, fetched by the
# service; project roots whose .agents/skills are read in place.
# GHOST_MCP_SECRETS=MCP_PROXY_KEY,GITHUB_TOKEN
# GHOST_SKILL_ROOTS=~/projects/one,~/projects/two
