---
/**
 * heyghost.app. One page: the float, what Ghost does, privacy, the desktop app, install, where
 * it stands. Every claim here is one the README or CLAUDE.md's rules make; when the product
 * changes what it promises, change this page in the same pull request.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Wordmark from "../components/Wordmark.astro";
import home from "../../../docs/screenshots/home.webp?url";
import session from "../../../docs/screenshots/session.webp?url";
import watching from "../../../docs/screenshots/watching.webp?url";
import agents from "../../../docs/screenshots/agents.webp?url";

const REPO = "https://github.com/heka-vault/ghost";
const DOWNLOAD = `${REPO}/releases/latest`;
const doc = (path: string) => `${REPO}/blob/main/${path}`;

const does = [
  {
    k: "Voice first",
    t: "Talk to it across the desk",
    p: "Say “Hey Ghost” and ask. It answers out loud, you can talk over it, and “that's all” sends it away. Typing works too, for when the room is not yours.",
  },
  {
    k: "Your machine",
    t: "It runs where you work",
    p: "The assistant, its ears and its voice run on your Linux desktop. There is no Ghost account and no Ghost server: your transcripts, settings and agents live in your home folder.",
  },
  {
    k: "Apps",
    t: "It uses the apps you connect",
    p: "GitHub, Linear, your calendar, and any app that speaks the Model Context Protocol. Connect it once, sign in or paste a key, and every agent can use it.",
  },
  {
    k: "Agents",
    t: "A team that works while you don't",
    p: "Hire agents with their own job, voice, memory and look. They run on a schedule with nobody there and leave what they found on a list for you.",
  },
  {
    k: "Changes",
    t: "It tells you what it changed",
    p: "By default Ghost does what you ask and says what it did. Your permissions name what it must ask about first or never do, and every change is in an audit log.",
  },
];

const privacy = [
  {
    t: "Before its name, nothing leaves",
    p: "While Ghost waits, the microphone feeds only models on your CPU: voice activity, the wake word and speech-to-text. What it hears is checked for its name and dropped, not logged, stored or shown.",
  },
  {
    t: "Its ears and voice are local",
    p: "Parakeet hears you and Kokoro speaks, both on your own processor, downloaded once on the first run. Your voice leaves the machine only if you turn on the optional realtime voice.",
  },
  {
    t: "You choose the model",
    p: "After the wake word, the conversation goes as text to the provider you pick: Anthropic, OpenRouter, OpenAI, or a local model through Ollama or LM Studio, and then nothing leaves at all.",
  },
  {
    t: "Passwords in its own vault",
    p: "Keys and tokens sit in an encrypted vault keyed by your login keyring. They are never shown again, never logged and never given to the model.",
  },
  {
    t: "Off means off",
    p: "Turn listening off with a switch, a key or “Ghost, stop listening”, and no microphone is opened at all until you turn it back on. Typing still works.",
  },
  {
    t: "What it keeps stays home",
    p: "Transcripts after the wake word and the audit log are kept under your home folder and never uploaded by Ghost. Delete the folder and everything it kept is gone.",
  },
];

const shots = [
  { src: home, t: "Today", p: "Today's summary, a change waiting for your okay, and the agents on the rail." },
  { src: session, t: "The conversation", p: "A live session as a timeline: what was said, which apps were called, what changed." },
  { src: watching, t: "Watching", p: "Schedules and watches: what runs with nobody there, and when." },
  { src: agents, t: "Agents", p: "Each agent's job, voice, shape and colour, hired and retired from here or by voice." },
];

const rough = [
  ["Waking", "how well it hears its name depends on the microphone, the room and the music. A headset or a good USB microphone does much better than a laptop's."],
  ["Speed", "a reply's pause is mostly the model. A slow provider, or a large local model on a CPU, makes Ghost wait; it tells you when it is too slow and what would help."],
  ["Sound", "it was tuned on one setup, a microphone array. Open speakers need the echo canceller it can set up for you, or headphones."],
  ["The float", "it needs X11 or XWayland (GNOME on Wayland has it), and hides while your screen is shared unless you choose to show it. No native Wayland, KDE or wlroots version yet."],
  ["Platforms", "Linux only, x86-64. The .deb and AppImage are checked on clean Ubuntu 24.04 and 26.04, not yet on many people's machines. The Android app is build-it-yourself."],
];
---

<Base
  title="Ghost: a voice on your own machine"
  description="Ghost is a voice-first assistant for your Linux desktop. Say its name and it floats in over your work, uses the apps you connect, answers out loud and tells you what it changed. Open source, MIT."
>
  <a class="skip" href="#main">Skip to the content</a>
  <header class="top">
    <a class="top__brand" href="/" aria-label="Ghost, home"><Wordmark /></a>
    <nav class="top__nav" aria-label="Sections">
      <a href="#float">The float</a>
      <a href="#privacy">Privacy</a>
      <a href="#install">Install</a>
      <a href={REPO}>GitHub</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="credit">Ghost · voice first · your machine</p>
        <h1 id="hero-title" class="hero__title">Say its name.<br /><span>It comes forward.</span></h1>
        <p class="hero__lede">
          Ghost is a voice assistant that lives on your Linux desktop. Call it and it floats in over your work, listens,
          reaches into the apps you connect, answers out loud, and drops back to a line of light when you're done.
        </p>
        <p class="hero__acts">
          <a class="btn btn--go" href={DOWNLOAD}>Download for Linux</a>
          <a class="btn" href={REPO}>Source on GitHub</a>
        </p>
        <p class="hero__fine">Free and open source under the MIT licence. Ubuntu 24.04 and 26.04, or any distribution with the AppImage. x86-64.</p>
      </div>
      <div class="hero__screen">
        <Hero />
      </div>
      <div class="hero__floor" aria-hidden="true"></div>
    </section>

    <section id="float" class="band band--float" aria-labelledby="float-title">
      <p class="credit"><span>01</span> The float</p>
      <h2 id="float-title">The window stays closed.</h2>
      <p class="band__lede">
        Most of the time Ghost is a thin line at the bottom of your screen. Say “Ghost” and it comes forward beside what
        you're working on, without taking the screen or the keyboard; clicks go straight through to your work.
      </p>
      <ol class="beats">
        <li>
          <h3><span class="dot dot--green"></span>It listens</h3>
          <p>
            Green while it hears you. It shows no transcript: you know what you said, and you hear what it says back.
          </p>
        </li>
        <li>
          <h3><span class="dot dot--violet"></span>It reaches</h3>
          <p>
            A beam goes out to every app and agent it looks in, lit while the call runs, the answer coming back as light the size of what
            it brought. You see where it looks while it works.
          </p>
        </li>
        <li>
          <h3><span class="dot dot--cyan"></span>It answers, and goes</h3>
          <p>
            It speaks, then falls back into the line. The only thing it asks you to read is a change waiting for your yes, or an
            agent's question: say the answer, or press the button.
          </p>
        </li>
      </ol>
      <p class="band__fine">
        The float is optional (Settings › General) and hides while your screen is shared, unless you choose to show it. It
        needs X11 or XWayland, which GNOME on Wayland has by default. <a href={doc("docs/floating-room.md")}>How it works</a>.
      </p>
    </section>

    <section class="band" aria-labelledby="does-title">
      <p class="credit"><span>02</span> What Ghost does</p>
      <h2 id="does-title">An assistant you talk to, on hardware you own.</h2>
      <div class="cards">
        {does.map((d) => (
          <article class="card">
            <p class="card__k">{d.k}</p>
            <h3>{d.t}</h3>
            <p>{d.p}</p>
          </article>
        ))}
      </div>
      <p class="band__fine">There is no undo. To reverse something, ask Ghost for the opposite change; it goes through the same permissions and lands in the same log.</p>
    </section>

    <section id="privacy" class="band band--privacy" aria-labelledby="privacy-title">
      <p class="credit"><span>03</span> Privacy</p>
      <h2 id="privacy-title">It listens. That is why it stays home.</h2>
      <p class="band__lede">
        An assistant that hears its name has its microphone open. Ghost is built so that what it hears before its name never
        leaves the computer, and what it keeps after is yours.
      </p>
      <dl class="facts">
        {privacy.map((f) => (
          <div>
            <dt>{f.t}</dt>
            <dd>{f.p}</dd>
          </div>
        ))}
      </dl>
      <p class="band__fine">
        What Ghost fetches by itself: the speech models once, from their publishers, and once a day a check of GitHub for a new
        release, carrying nothing about you (you can turn it off). The full account is the README's
        <a href={`${REPO}#privacy`}>Privacy</a> section. This site has no analytics, sets no cookies and loads nothing from anyone else.
      </p>
    </section>

    <section class="band" aria-labelledby="app-title">
      <p class="credit"><span>04</span> The desktop app</p>
      <h2 id="app-title">A briefing at the desk.</h2>
      <p class="band__lede">
        When you want to read rather than talk, the app shows the day, the live conversation, what Ghost is watching, and every
        change it made.
      </p>
      <div class="shots">
        {shots.map((s, i) => (
          <figure class="shot">
            <img src={s.src} width="1440" height="900" alt={`Ghost's desktop app: ${s.t}. ${s.p}`} loading="lazy" decoding="async" />
            <figcaption>
              <b>{s.t}</b> {s.p}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="install" class="band band--install" aria-labelledby="install-title">
      <p class="credit"><span>05</span> Install</p>
      <h2 id="install-title">Three steps, then talk.</h2>
      <div class="install">
        <ol class="steps">
          <li>
            <h3>Download</h3>
            <p>
              <code>heka-ghost-desktop_&lt;version&gt;_amd64.deb</code> from the latest release, or the
              <code>.AppImage</code> for other distributions.
            </p>
          </li>
          <li>
            <h3>Install</h3>
            <p>
              Open it with App Center, or run
              <code>sudo apt install ./heka-ghost-desktop_&lt;version&gt;_amd64.deb</code>. apt brings what it needs.
            </p>
          </li>
          <li>
            <h3>Open Ghost</h3>
            <p>
              The first run walks you through the rest: its ears and voice (2.9 GB, downloaded once with progress), a model, the
              microphone, the wake word, a voice, an app and an agent. Every step can be skipped.
            </p>
          </li>
        </ol>
        <aside class="needs" aria-labelledby="needs-title">
          <h3 id="needs-title">What it needs</h3>
          <ul>
            <li>Linux on x86-64: the .deb on Ubuntu 24.04 or 26.04, the AppImage elsewhere (with FUSE 2).</li>
            <li>A model: a key from Anthropic, OpenRouter or OpenAI, or a local model in Ollama or LM Studio.</li>
            <li>A microphone and speakers or a headset. No microphone? Type to it instead.</li>
            <li>About 3 GB of disk for the speech models, which run on the CPU: no graphics card needed.</li>
          </ul>
          <a class="btn btn--go" href={DOWNLOAD}>Download the latest release</a>
          <p class="needs__fine">
            Updates: Ghost checks for a new release and installs one only when you press Update and restart.
            <a href={`${REPO}#build-from-source`}>Build from source</a> instead.
          </p>
        </aside>
      </div>
    </section>

    <section class="band band--status" aria-labelledby="status-title">
      <p class="credit"><span>06</span> Where it stands</p>
      <h2 id="status-title">Young, and built at one desk.</h2>
      <p class="band__lede">
        Ghost works end to end on a stock machine, but it was built for one person's desk, and it shows. These are the rough
        edges we know about:
      </p>
      <dl class="rough">
        {rough.map(([t, p]) => (
          <div>
            <dt>{t}</dt>
            <dd>{p}</dd>
          </div>
        ))}
      </dl>
      <p class="band__fine">Found another? <a href={`${REPO}/issues`}>Open an issue</a>; <a href={doc("CONTRIBUTING.md")}>CONTRIBUTING.md</a> says what to put in it.</p>
    </section>
  </main>

  <footer class="foot">
    <div class="foot__brand"><Wordmark /><p>A voice on your own machine.</p></div>
    <nav class="foot__links" aria-label="More">
      <div>
        <h2>Ghost</h2>
        <a href={DOWNLOAD}>Download</a>
        <a href={`${REPO}/releases`}>Releases</a>
        <a href={REPO}>Source</a>
        <a href={doc("LICENSE")}>MIT licence</a>
      </div>
      <div>
        <h2>Docs, on GitHub</h2>
        <a href={`${REPO}#readme`}>README</a>
        <a href={doc("docs/floating-room.md")}>The floating room</a>
        <a href={doc("docs/apps.md")}>Connecting apps</a>
        <a href={doc("docs/architecture.md")}>Architecture</a>
      </div>
    </nav>
    <p class="foot__fine">The pictures on this page are the app's own screens, playing made-up data. No cookies, no analytics.</p>
  </footer>
</Base>
