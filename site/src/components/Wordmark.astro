---
/** Wisp at rest (the brand glyph, packages/ui) and the name. */
import { wispGlyph } from "@ghost/ui/src/wisp";
const d = wispGlyph(false);
---

<span class="mark">
  <svg class="mark__wisp" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d={d}></path></svg>
  <span class="mark__name">Ghost</span>
</span>
